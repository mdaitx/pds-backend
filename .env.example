# Copie para .env e preencha

DATABASE_URL=
DIRECT_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Várias origens: separar por vírgula. Se o front for aberto por IP na LAN (ex.: http://192.168.x.x:3000),
# inclua essa URL no .env — o navegador trata como origem diferente de localhost (CORS).
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# E-mails transacionais (Resend — https://resend.com)
# Sem RESEND_API_KEY + RESEND_FROM, os envios são omitidos (só log em debug).
#
# Sem domínio verificado: a Resend só entrega para o e-mail da conta (modo teste).
# Para enviar a qualquer destinatário: Domains → adicionar DNS → usar RESEND_FROM com esse domínio.
# RESEND_API_KEY=re_xxxx
# RESEND_FROM="Truck Finanças <noreply@seudominio.com>"
