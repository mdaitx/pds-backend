NODE_ENV=production
PORT=4000

# Supabase Postgres / Prisma
#
# LOCAL (Windows/macOS com IPv6): conexão direta funciona
#   DATABASE_URL=postgresql://postgres:[senha]@db.[ref].supabase.co:5432/postgres
#   DIRECT_URL=postgresql://postgres:[senha]@db.[ref].supabase.co:5432/postgres
#
# RENDER / IPv4-only (obrigatório): use o Supavisor (pooler) — copie do Dashboard
#   Settings > Database > Connection string > Connection pooling
#   Usuário no pooler: postgres.[ref] (não só "postgres")
#   DATABASE_URL (transaction, 6543): ...pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30
#   DIRECT_URL (session pooler, 5432): ...pooler.supabase.com:5432/postgres?connect_timeout=30
#   NÃO use db.[ref].supabase.co no Render — dá P1001 (IPv6 inalcançável).
#
DATABASE_URL=postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30
DIRECT_URL=postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:5432/postgres?connect_timeout=30

# Supabase API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-somente-no-backend

# URLs publicas
CORS_ORIGIN=https://seu-frontend.vercel.app
FRONTEND_URL=https://seu-frontend.vercel.app

# Limites de taxa (anti abuso / brute force)
RATE_LIMIT_GLOBAL_TTL_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_TTL_MS=900000
RATE_LIMIT_RECOVER_MAX=5
RATE_LIMIT_INVITE_MAX=20

# Stripe, se assinatura estiver ativa
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=
# Legado (apenas para sincronização de assinaturas antigas por veículo):
STRIPE_PRICE_ID=
# Opcional: fixa a versao de API usada pelo SDK stripe-node.
# Em modo teste, mantenha alinhado com a versao suportada no pacote "stripe".
STRIPE_API_VERSION=2025-02-24.acacia

# Use true apenas quando precisar expor /api/docs em producao
SWAGGER_ENABLED=false
