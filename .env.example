# Copie para .env e preencha

DATABASE_URL=
DIRECT_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS (origem do frontend em produção)
CORS_ORIGIN=http://localhost:3000

# URLs nos e-mails de notificação
FRONTEND_URL=http://localhost:3000

# SMTP opcional — sem SMTP_HOST, e-mails não são enviados (API segue normal)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Truck Finanças <noreply@example.com>"
