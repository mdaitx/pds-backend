# Dependencies
/node_modules

# Package managers (unused entries are harmless; keeps clones consistent across npm/yarn/pnpm)
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build & TypeScript
/dist
/build
*.tsbuildinfo

# Environment — não versionar variáveis nem template local (.env, .env.*, .env.example)
.env*

# TLS / local certs
*.pem

# IDE & editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
[Dd]esktop.ini

# Logs & package-manager debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Lint cache
.eslintcache

# Tests & coverage
coverage/
.nyc_output/
